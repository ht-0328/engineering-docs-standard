# 参考書のPDF原本。購入者ウォーターマーク（メールアドレス）を含むため追跡しない。
references/*.pdf

# PDFから抽出した本文。原本の複製にあたるため追跡しない。要約は research/notes/ に残す。
research/extracted/

# 生成物。docs/ と diagrams/src/ から再生成できる。
site/
diagrams/export/

# Zensical 版の生成物。build/ は docs/ の写しで、site-zensical/ はその出力である。
# どちらも tools/build_site_zensical.py が作り直す。
build/
site-zensical/

# Python
__pycache__/
*.pyc
.venv/

# 外部から取得した一次資料。再取得できるためGit管理しない。
research/external-sources/

# 同梱するライブラリ。tools/build_site.py が取得元を記録している。
tools/vendor/

# 独立レビューの生出力。まとめたあとは残さない。
# reviews/ に残すのは、判定と対応をまとめた記録だけである。
reviews/*-raw-*.md
