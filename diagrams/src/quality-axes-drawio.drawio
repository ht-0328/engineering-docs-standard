        <mxCell id="a1" value="1. 有用性&#xa;読者の課題を解決するか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a56db;fontSize=13" vertex="1" parent="1">
