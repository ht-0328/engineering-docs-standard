        <mxCell id="root" value="良い文書&#xa;= 読者が用を足せる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a56db;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1" vertex="1" parent="1">
